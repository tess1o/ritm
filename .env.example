# Local development settings for `make dev` (copied to .env on first run).
# created on startup if it does not exist yet (never overwritten)
RITM_INIT_USER=admin
RITM_INIT_PASSWORD=change-me-please
# RITM_REGISTRATION_ENABLED=true
RITM_DATA_DIR=./data
RITM_LISTEN_ADDR=127.0.0.1:7486
# RITM_TZ=UTC   # users get their browser's zone at sign-in; this is the fallback
RITM_LOG_LEVEL=info
# RITM_BASE_URL=https://ritm.example
# RITM_DELTA_WINDOW=168h
# RITM_STALE_AFTER=336h
# RITM_TRUSTED_PROXIES=127.0.0.1
RITM_SHORTCUT_URL=https://www.icloud.com/shortcuts/efcd38d390754327925c710a4c2c58e6   # the default; set your own build of Send to Ritm
